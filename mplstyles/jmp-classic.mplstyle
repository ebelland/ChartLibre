# ============================================================
# JMP Classic
# JMP's default preferences (Preferences > Styles): a grey frame
# on all four sides, ticks outside, no grid lines (light grey when
# turned on), white plot, black points, red fit lines, grey-green
# histogram bars with no outline.
# ============================================================

# ------------------------------------------------------------
# Figure - window background: white
# ------------------------------------------------------------

figure.figsize: 6.4, 4.4
figure.dpi: 120
figure.facecolor: white

savefig.facecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.transparent: False

# ------------------------------------------------------------
# Fonts - JMP's sans-serif, small axis text
# ------------------------------------------------------------

font.family: sans-serif
font.sans-serif: Segoe UI, Helvetica Neue, Arial, Helvetica, DejaVu Sans
font.size: 9

axes.titlesize: 10
axes.titleweight: bold
axes.labelsize: 9
axes.labelcolor: 000000
xtick.labelsize: 8
ytick.labelsize: 8
xtick.labelcolor: 000000
ytick.labelcolor: 000000
legend.fontsize: 8

mathtext.fontset: dejavusans

# ------------------------------------------------------------
# Frame - "Frame color" dark grey, "Frame border" on: all four sides
# ------------------------------------------------------------

axes.facecolor: white
axes.edgecolor: 8C8C8C
axes.linewidth: 0.8
axes.spines.top: True
axes.spines.right: True
axes.axisbelow: True
axes.xmargin: 0.04
axes.ymargin: 0.04

# First series black, as JMP draws points; red second, as its fit lines.
axes.prop_cycle: cycler('color', ['000000', 'C8484E', '2F6EBA', '4E9A47', 'E38D2C', '8064A2', '4BACC6', '808080'])

# ------------------------------------------------------------
# Grid lines - off by default; major light grey, minor lighter
# ------------------------------------------------------------

axes.grid: False
axes.grid.which: major
grid.linestyle: -
grid.linewidth: 0.6
grid.major.color: C8C8C8
grid.minor.color: E6E6E6
grid.minor.linewidth: 0.5

# ------------------------------------------------------------
# Ticks - outside the frame ("tick marks inside" off)
# ------------------------------------------------------------

xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 2
ytick.minor.size: 2
xtick.major.width: 0.7
ytick.major.width: 0.7
xtick.minor.visible: False
ytick.minor.visible: False
xtick.color: 8C8C8C
ytick.color: 8C8C8C

# ------------------------------------------------------------
# Points and lines - solid black dots; fit lines in red
# ------------------------------------------------------------

lines.linewidth: 1.4
lines.markersize: 4
lines.markeredgewidth: 0
scatter.marker: o
scatter.edgecolors: face

# ------------------------------------------------------------
# Shapes - "Shape border" grey; histogram bars grey-green with
# no line ("Histogram line color" none)
# ------------------------------------------------------------

patch.facecolor: B4C8B4
patch.edgecolor: BFBFBF
patch.force_edgecolor: False
patch.linewidth: 0.6
hist.bins: auto

# ------------------------------------------------------------
# Box plots - outlines only, black, as JMP's outlier box plot
# ------------------------------------------------------------

boxplot.patchartist: False
boxplot.showmeans: False
boxplot.showfliers: True
boxplot.boxprops.color: 000000
boxplot.boxprops.linewidth: 0.9
boxplot.whiskerprops.color: 000000
boxplot.whiskerprops.linewidth: 0.9
boxplot.capprops.color: 000000
boxplot.capprops.linewidth: 0.9
boxplot.medianprops.color: 000000
boxplot.medianprops.linewidth: 1.2
boxplot.flierprops.marker: o
boxplot.flierprops.markerfacecolor: 000000
boxplot.flierprops.markeredgecolor: 000000
boxplot.flierprops.markersize: 3

# ------------------------------------------------------------
# Error bars, legend, images
# ------------------------------------------------------------

errorbar.capsize: 3
legend.frameon: False
legend.handlelength: 1.5
legend.handletextpad: 0.4
image.cmap: Greys

# ------------------------------------------------------------
# Vector export: text stays text
# ------------------------------------------------------------

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
