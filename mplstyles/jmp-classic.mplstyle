# ============================================================
# JMP Classic
# Inspired by JMP Distribution, Fit Y by X, Graph Builder
# ============================================================

# ------------------------------------------------------------
# Figure
# ------------------------------------------------------------

figure.figsize: 6.4, 4.4
figure.dpi: 120
figure.facecolor: white

savefig.facecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.05

# ------------------------------------------------------------
# Fonts
# ------------------------------------------------------------

font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans

font.size: 9

axes.labelsize: 8
axes.titlesize: 11
axes.titleweight: bold

xtick.labelsize: 7
ytick.labelsize: 7

legend.fontsize: 7

mathtext.fontset: dejavusans

# ------------------------------------------------------------
# Axes
# ------------------------------------------------------------

axes.facecolor: white

axes.edgecolor: A6A6A6
axes.linewidth: 0.7

axes.grid: False

axes.axisbelow: False

# IMPORTANT:
# first series black like JMP scatter plots

axes.prop_cycle: cycler('color',
    ['111111',
     '4A72B2',
     'CC6677',
     '55A868',
     '8172B3',
     'C9A44C',
     '64B5CD',
     '8A8A8A'])

# ------------------------------------------------------------
# Lines
# ------------------------------------------------------------

lines.linewidth: 1.2
lines.markersize: 4
lines.markeredgewidth: 0.5

# ------------------------------------------------------------
# Scatter
# ------------------------------------------------------------

scatter.marker: o

# ------------------------------------------------------------
# Histograms & Bars
# JMP green-gray default
# ------------------------------------------------------------

patch.facecolor: B8C9BB

patch.edgecolor: 777777
patch.linewidth: 0.7

hist.bins: 8

# ------------------------------------------------------------
# Error bars
# ------------------------------------------------------------

errorbar.capsize: 4

# ------------------------------------------------------------
# Legend
# ------------------------------------------------------------

legend.frameon: False

legend.handlelength: 1.5
legend.handletextpad: 0.4

# ------------------------------------------------------------
# Ticks
# ------------------------------------------------------------

xtick.direction: out
ytick.direction: out

xtick.major.size: 3
ytick.major.size: 3

xtick.major.width: 0.6
ytick.major.width: 0.6

xtick.minor.visible: False
ytick.minor.visible: False

xtick.color: 555555
ytick.color: 555555

# ------------------------------------------------------------
# Boxplots
# White box + black outlines
# ------------------------------------------------------------

boxplot.patchartist: True

boxplot.showmeans: False
boxplot.showfliers: True

boxplot.boxprops.color: 111111
boxplot.boxprops.linewidth: 1.0

boxplot.whiskerprops.color: 111111
boxplot.whiskerprops.linewidth: 1.0

boxplot.capprops.color: 111111
boxplot.capprops.linewidth: 1.0

boxplot.medianprops.color: 111111
boxplot.medianprops.linewidth: 1.4

boxplot.flierprops.marker: .

boxplot.flierprops.markerfacecolor: 111111
boxplot.flierprops.markeredgecolor: 111111

boxplot.flierprops.markersize: 3

# ------------------------------------------------------------
# Images
# ------------------------------------------------------------

image.cmap: Greys

# ------------------------------------------------------------
# SVG / PDF
# ------------------------------------------------------------

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

# ------------------------------------------------------------
# Tight export
# ------------------------------------------------------------

savefig.transparent: False