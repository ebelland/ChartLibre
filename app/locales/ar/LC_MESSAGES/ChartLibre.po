msgstr "جزء من كل جزء تمت مشاركته مع الجزء التالي."

msgid "Free plan keys end in :fx"
msgstr "تنتهي مفاتيح الخطة المجانية بـ :fx"

msgid "From x:"
msgstr "من x:"

msgid "Full factorial"
msgstr "عاملي كامل"

msgid "Full outer: every row"
msgstr "كامل الخارج: كل صف"

