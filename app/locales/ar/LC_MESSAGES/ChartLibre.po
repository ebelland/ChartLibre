msgstr "Gage R&R"

msgid "Gamma"
msgstr "جاما"

msgid "Gap V"
msgstr "الثغرة V"

msgid "Gap between shared axes side by side. 0 draws them flush."
msgstr "فجوة بين المحاور المشتركة جنبًا إلى جنب. 0 يرسمها متدفقة."

msgid "Gap between shared axes stacked one above the other. 0 draws them flush."
msgstr "الفجوة بين المحاور المشتركة مكدسة فوق بعضها البعض. 0 يرسمها متدفقة."

msgid "Gaussian process regression with an uncertainty band"
msgstr "انحدار العملية الغاوسية مع نطاق عدم اليقين"

