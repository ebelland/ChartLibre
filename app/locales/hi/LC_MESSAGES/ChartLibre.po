# hi translation for ChartLibre.
# Message ids are the English source strings.

msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid " cm"
msgstr " सेमी"

msgid " dec."
msgstr " दिसंबर"

msgid "\"{code}\" already has a catalogue."
msgstr "\"{code}\" में पहले से ही एक कैटलॉग है।"

msgid "\"{name}\" is already used by an existing chart type."
msgstr "\"{name}\" पहले से ही एक मौजूदा चार्ट प्रकार द्वारा उपयोग किया जाता है।"

msgid "\"{name}\" is already used by an existing data operation."
msgstr "\"{name}\" पहले से ही एक मौजूदा डेटा ऑपरेशन द्वारा उपयोग किया जाता है।"

msgid "\"{name}\" is already used by an existing function."
msgstr "\"{name}\" पहले से ही एक मौजूदा फ़ंक्शन द्वारा उपयोग किया जाता है।"

msgid "'{key}' back to Matplotlib's default."
msgstr "Matplotlib के डिफ़ॉल्ट पर वापस '{key}'।"

msgid "'{name}' is already a column of this table."
msgstr "'{name}' पहले से ही इस तालिका का एक स्तंभ है।"

msgid "(Default)"
msgstr "(डिफ़ॉल्ट)"

msgid "(Embedded style)"
msgstr "(एम्बेडेड स्टाइल)"

msgid "(empty)"
msgstr "(खाली)"

msgid "(none)"
msgstr "(कोई नहीं)"

msgid "(row number)"
msgstr "(पंक्ति संख्या)"

msgid "(row numbers)"
msgstr "(पंक्ति संख्या)"

msgid "(rows)"
msgstr "(पंक्तियाँ)"

msgid "**Demo** - a fixed script, not an AI: it shows what the assistant does with the project's tools. With a real provider the answer is written for your question."
msgstr "**डेमो** - एक निश्चित स्क्रिप्ट, AI नहीं: यह दिखाता है कि सहायक परियोजना के टूल के साथ क्या करता है। एक वास्तविक प्रदाता के साथ आपके प्रश्न के लिए उत्तर लिखा गया है।"

msgid "-999, NA, n/d"
msgstr "-999, लागू नहीं, लागू नहीं"

msgid "...and {count} more, under Show Details."
msgstr "...और {count} और अधिक, विवरण दिखाएँ के तहत।"

msgid "...and {count} more."
msgstr "...और {count} और।"

msgid "0 chooses them by cross-validation: another component only while it cuts the prediction error by 5% or more."
msgstr "0 उन्हें क्रॉस - वैलिडेशन द्वारा चुनता है: एक और घटक केवल तभी जबकि यह भविष्यवाणी त्रुटि को 5% या अधिक से काटता है।"

msgid "0 finds it from the dates (12 for months, 7 for days, 4 for quarters); 1 means none."
msgstr "0 इसे तारीखों से ढूंढता है (महीनों के लिए 12, दिनों के लिए 7, तिमाहियों के लिए 4); 1 का मतलब है कोई नहीं।"

msgid "0 interpolates every point exactly; larger values allow the spline to depart from noisy data."
msgstr "0 प्रत्येक बिंदु को बिल्कुल इंटरपोलेट करता है; बड़े मान स्पलाइन को शोर वाले डेटा से विदा करने की अनुमति देते हैं।"

msgid "0 takes as many as the correlations have eigenvalues above 1 (see the scree plot)."
msgstr "0 उतना ही लेता है जितना सहसंबंधों का आइजनवैल्यू 1 से ऊपर होता है (स्क्र्री प्लॉट देखें)।"

msgid "0 tries every k up to the maximum and keeps the one with the highest mean silhouette."
msgstr "0 प्रत्येक k को अधिकतम तक आज़माता है और उच्चतम औसत सिल्हूट वाले व्यक्ति को रखता है।"

msgid "1 and 2 sigma lines:"
msgstr "1 और 2 सिग्मा लाइनें:"

msgid "1 for a series that wanders or has a trend; 0 for one that comes back to its mean."
msgstr "1 एक श्रृंखला के लिए जो भटकती है या एक प्रवृत्ति है; 0 एक के लिए जो अपने औसत पर वापस आती है।"

msgid "1 for the slope, 2 for the curvature."
msgstr "ढलान के लिए 1, वक्रता के लिए 2।"

msgid "1 leaves x alone; 2 doubles it about the centre below."
msgstr "1 अकेले x को छोड़ देता है; 2 इसे नीचे के केंद्र के बारे में दोगुना कर देता है।"

msgid "1 leaves y alone; 2 doubles it about the centre below."
msgstr "1 अकेले छोड़ देता है; 2 इसे नीचे के केंद्र के बारे में दोगुना कर देता है।"

msgid "1 leaves z alone; 2 doubles it about the centre below."
msgstr "1 अकेले z को छोड़ देता है; 2 इसे नीचे के केंद्र के बारे में दोगुना कर देता है।"

msgid "1 takes away last season's value: for a season that repeats steadily."
msgstr "1 पिछले सीज़न का मूल्य छीन लेता है: एक ऐसे सीज़न के लिए जो लगातार दोहराता रहता है।"

msgid "2D (x, y)"
msgstr "2D (x, y)"

msgid "3 is the Shewhart convention: on a stable normal process it gives about one false alarm per 370 points, which balances missed signals against chasing noise."
msgstr "3 शेवर्ट कन्वेंशन है: एक स्थिर सामान्य प्रक्रिया पर यह प्रति 370 बिंदुओं पर लगभग एक गलत अलार्म देता है, जो शोर का पीछा करने के खिलाफ मिस सिग्नल को संतुलित करता है।"

msgid "3D on a grid (x, y, z)"
msgstr "ग्रिड पर 3D (x, y, z)"

msgid "3D scattered (x, y, z)"
msgstr "3D बिखरे हुए (x, y, z)"

msgid "95% CI high"
msgstr "95% CI उच्च"

msgid "95% CI low"
msgstr "95% CI कम"

msgid "95% CI of the mean"
msgstr "औसत का 95% CI"

msgid "95% confidence band"
msgstr "95 % c ऑन - कॉन्फिडेंस बैंड"

msgid "95% prediction band"
msgstr "95% प्रिडिक्शन बैंड"

msgid "95% prediction interval"
msgstr "95% पूर्वानुमान अंतराल"

msgid "A GPX file's track, route and waypoints: latitude, longitude, elevation, time."
msgstr "एक GPX फ़ाइल का ट्रैक, मार्ग और वेपॉइंट: अक्षांश, देशांतर, ऊंचाई, समय।"

msgid "A LabVIEW Write To Measurement File text file: each segment a dataset."
msgstr "एक LabVIEW राइट टू मेजरमेंट फ़ाइल टेक्स्ट फ़ाइल: प्रत्येक सेगमेंट एक डेटासेट है।"

msgid "A MATLAB .mat file (v4 to v7): each numeric variable a dataset, or all of one length side by side."
msgstr "एक MATLAB .mat फ़ाइल (v4 से v7): प्रत्येक संख्यात्मक चर एक डेटासेट, या एक साथ एक लंबाई के सभी।"

msgid "A Prism XML project: each data table a dataset, replicates as numbered columns."
msgstr "एक प्रिज्म XML प्रोजेक्ट: प्रत्येक डेटा टेबल एक डेटासेट है, जो क्रमांकित कॉलम के रूप में दोहराता है।"

msgid "A SAS dataset (.sas7bdat) or transport file (.xpt)."
msgstr "एक SAS डेटासेट (.sas7bdat) या ट्रांसपोर्ट फ़ाइल (.xpt)."

msgid "A Stata dataset (.dta), value labels as categories."
msgstr "एक STATA डेटासेट (.dta), श्रेणियों के रूप में मूल्य लेबल।"

msgid "A VNA's .sNp file: frequency and each S (or Y, Z) parameter as its file gives it."
msgstr "एक VNA की .sNp फ़ाइल: आवृत्ति और प्रत्येक S (या Y, Z) पैरामीटर जैसा कि इसकी फ़ाइल इसे देती है।"

msgid "A WAV recording: time and one column per channel."
msgstr "एक WAV रिकॉर्डिंग: प्रति चैनल समय और एक कॉलम।"

msgid "A circuit simulation's waveforms: one column per trace; each plot a dataset, .step runs numbered."
msgstr "एक सर्किट सिमुलेशन के तरंग रूप: प्रति ट्रेस एक कॉलम; प्रत्येक प्लॉट एक डेटासेट, .step क्रमांकित चलता है।"

msgid "A column cannot be both a response and a factor: {columns}."
msgstr "एक कॉलम एक प्रतिक्रिया और एक कारक दोनों नहीं हो सकता है: {columns} ।"

msgid "A few directions that carry most of the variation of many columns: eigenvalues and their share, loadings, each row's scores; scree, score and loading plots."
msgstr "कुछ दिशाएँ जो कई स्तंभों की अधिकांश भिन्नता को ले जाती हैं: आइजनवैल्यू और उनका हिस्सा, लोडिंग, प्रत्येक पंक्ति के स्कोर; स्क्री, स्कोर और लोडिंग प्लॉट।"

msgid "A few hidden factors behind many correlated columns: Maximum Likelihood or Principal Axis, rotated (Varimax, Quartimax, Equamax, Promax); loadings, communalities, each row's scores."
msgstr "कई सहसंबद्ध कॉलम के पीछे कुछ छिपे हुए कारक: अधिकतम संभावना या प्रिंसिपल एक्सिस, घुमाए गए (Varimax, Quartimax, Equamax, Promax); लोडिंग, सांप्रदायिकता, प्रत्येक पंक्ति के स्कोर।"

msgid "A field in space needs both Z and W; a flat one neither."
msgstr "अंतरिक्ष में एक क्षेत्र को Z और W दोनों की आवश्यकता होती है; एक सपाट क्षेत्र को न तो।"

msgid "A file named \"{file}\" already exists under user/charts/."
msgstr "\"{file}\" नाम की एक फ़ाइल पहले से ही उपयोगकर्ता/चार्ट/के तहत मौजूद है।"

msgid "A file named \"{file}\" already exists under user/data_operations/."
msgstr "\"{file}\" नाम की एक फ़ाइल पहले से ही USER/DATA_OPERATIONS/के तहत मौजूद है।"

msgid "A file named \"{file}\" already exists under user/functions/."
msgstr "\"{file}\" नाम की एक फ़ाइल पहले से ही उपयोगकर्ता/फ़ंक्शंस/के तहत मौजूद है।"

msgid "A guide line under the pointer, shared across every axes of this figure."
msgstr "पॉइंटर के नीचे एक गाइड लाइन है, जो इस आकृति के हर अक्ष में साझा की गई है।"

msgid "A line across the whole axes, at this x."
msgstr "इस एक्स पर, पूरे अक्षों के पार एक रेखा।"

msgid "A line along the whole axes, at this y."
msgstr "इस y पर, पूरे अक्षों के साथ एक रेखा।"

msgid "A logic analyser's or a digital simulation's signals: a row per change, every signal's value."
msgstr "एक तर्क विश्लेषक या एक डिजिटल सिमुलेशन के सिग्नल: प्रति परिवर्तन एक पंक्ति, प्रत्येक सिग्नल का मान।"

msgid "A measure in time order: its autocorrelation (ACF, PACF, Ljung-Box), its trend and season (STL), and an ARIMA or exponential-smoothing forecast with its prediction interval."
msgstr "समय क्रम में एक उपाय: इसका स्वतःसंबंध (ACF, PACF, Ljung - Box), इसकी प्रवृत्ति और मौसम (STL), और इसकी भविष्यवाणी अंतराल के साथ एक ARIMA या घातीय - चिकनाई पूर्वानुमान।"

msgid "A model of {response} on its strongest factors: {factors}"
msgstr "अपने सबसे मजबूत कारकों पर {response} का एक मॉडल: {factors}"

msgid "A new chart of this table"
msgstr "इस तालिका का एक नया चार्ट"

msgid "A new figure with this column's histogram, and its statistics in the figure's notes"
msgstr "इस कॉलम के हिस्टोग्राम के साथ एक नया आंकड़ा, और आंकड़े के नोट्स में इसके आंकड़े"

msgid "A row for each distinct value not listed yet (up to {n})."
msgstr "अभी तक सूचीबद्ध नहीं किए गए प्रत्येक विशिष्ट मान के लिए एक पंक्ति ({n} तक)।"

msgid "A ruler between two points, with its dx/dy/slope written beside it - the same thing a chart's own \"Measure from here\" / \"Measure to here\" right-click actions create. Color has its own column; anything else goes in Kwargs JSON."
msgstr "दो बिंदुओं के बीच एक रूलर, जिसके बगल में dx/dy/slope लिखा होता है - वही चीज़ जो एक चार्ट का अपना \"Measure from here\" / \"Measure to here\" राइट - क्लिक क्रियाएँ बनाती हैं। रंग का अपना कॉलम है; कुछ भी Kwargs JSON में जाता है।"

msgid "A second scale along the top (x) or the right (y): this axis in other units."
msgstr "शीर्ष (x) या दाएं (y) के साथ एक दूसरा पैमाना: अन्य इकाइयों में यह अक्ष।"

msgid "A spectrum (IR, UV-Vis, Raman, NMR, MS) in JCAMP-DX: x and y with their units; each block a dataset."
msgstr "जेसीएएमपी - डीएक्स: एक्स और वाई में एक स्पेक्ट्रम (आईआर, यूवी - वीआईएस, रमन, एनएमआर, एमएस) उनकी इकाइयों के साथ; प्रत्येक एक डेटासेट को ब्लॉक करता है।"

msgid "A step lasts from then on; a pulse affects that one time only."
msgstr "तब से एक कदम चलता है; एक नाड़ी केवल एक बार प्रभावित करती है।"

msgid "A table needs at least one column. Add another column before deleting this one."
msgstr "एक टेबल को कम से कम एक कॉलम की ज़रूरत होती है। इसे हटाने से पहले एक और कॉलम जोड़ें।"

msgid "A table needs at least one row. Add another row before deleting this one."
msgstr "एक टेबल को कम से कम एक पंक्ति की आवश्यकता होती है। इसे हटाने से पहले एक और पंक्ति जोड़ें।"

msgid "A table or query named '{name}' already exists."
msgstr "'{name}' नाम की एक तालिका या क्वेरी पहले से मौजूद है।"

msgid "A table's columns."
msgstr "टेबल के कॉलम।"

msgid "A term is significant when its p-value is at most this; the Stepwise personality adds or keeps only such terms."
msgstr "एक शब्द तब महत्वपूर्ण होता है जब इसका पी - वैल्यू अधिक से अधिक होता है; स्टेपवाइज व्यक्तित्व केवल ऐसे शब्दों को जोड़ता है या रखता है।"

msgid "A text note pinned to this point: x = {x}, y = {y}."
msgstr "इस बिंदु तक पिन किया गया एक टेक्स्ट नोट: x = {x}, y = {y} ।"

msgid "A vector field sampled on a grid: its divergence (where it spreads out or gathers) and its curl (where and how fast it turns), in 2D or 3D."
msgstr "ग्रिड पर सैंपल किया गया एक वेक्टर फ़ील्ड: इसका डायवर्जेंस (जहाँ यह फैलता है या इकट्ठा होता है) और 2D या 3D में इसका कर्ल (जहाँ और कितनी तेज़ी से मुड़ता है)।"

msgid "A vertical or horizontal line across the whole axes, at a value in data coordinates. Color and style have their own columns; anything else goes in Kwargs JSON, for example: {\"linewidth\": 2, \"label\": \"limit\"}."
msgstr "डेटा निर्देशांक में मान पर, पूरे अक्षों में एक ऊर्ध्वाधर या क्षैतिज रेखा। रंग और शैली के अपने कॉलम हैं; कुछ भी Kwargs JSON में जाता है, उदाहरण के लिए: {\"linewidth\": 2, \"label\": \"limit\"} ।"

msgid "AAB;CCB"
msgstr "AAB;CCB"

msgid "AIC"
msgstr "AIC"

msgid "AIC (penalises free parameters)"
msgstr "एआईसी (मुफ्त पैरामीटर को दंडित करता है)"

msgid "API key"
msgstr "API कुंजी"

msgid "ARIMA d (differences):"
msgstr "अरिमा घ (अंतर):"

msgid "ARIMA only: a date (or a number of the time column) when something changed - a new process, a policy, a fault. Its estimate is the change it made."
msgstr "केवल अरिमा: एक तारीख (या कई बार कॉलम) जब कुछ बदल जाता है - एक नई प्रक्रिया, एक नीति, एक गलती। इसका अनुमान उसके द्वारा किए गए परिवर्तन का है।"

msgid "ARIMA only: the input enters the model at the lag where its prewhitened cross-correlation is strongest; its coefficient says how much Y moves per unit of X. Ahead of that lag the forecast uses X's own forecast."
msgstr "केवल ARIMA: इनपुट उस अंतराल पर मॉडल में प्रवेश करता है जहाँ इसका पूर्व - सफ़ेद क्रॉस - सहसंबंध सबसे मजबूत होता है; इसका गुणांक बताता है कि X की प्रति इकाई Y कितनी गति करता है। उस अंतराल से पहले पूर्वानुमान X के अपने पूर्वानुमान का उपयोग करता है।"

msgid "ARIMA p (autoregressive):"
msgstr "ARIMA p (autoregressive):"

msgid "ARIMA q (moving average):"
msgstr "ARIMA q (मूविंग एवरेज):"

msgid "ARIMA with a season: how many past seasons the next value depends on (the ACF's spikes at the season's multiples)."
msgstr "एक सीज़न के साथ अरिमा: पिछले कितने सीज़न पर अगला वैल्यू निर्भर करता है (सीज़न के मल्टीपल पर ACF की स्पाइक्स)।"

msgid "ARIMA: the next value from the last ones (p), the changes (d) and the last errors (q), with a season (P, D, Q) of its own. ARIMA, order chosen by AIC: the differences from the stationarity tests, then the p, q, P, Q with the lowest AIC. Exponential smoothing: a level, a trend and a season that each follow the newest values most."
msgstr "अरिमा: अंतिम वाले (p), परिवर्तनों (d) और अंतिम त्रुटियों (q) से अगला मान, जिसका अपना एक सीज़न (P, D, Q) है। अरिमा, AIC द्वारा चुना गया क्रम: स्थिर परीक्षणों से अंतर, फिर सबसे कम AIC वाला p, q, P, Q। घातीय चौरसाई: एक स्तर, एक प्रवृत्ति और एक मौसम जो प्रत्येक नवीनतम मूल्यों का सबसे अधिक पालन करता है।"

msgid "AUC = {value}: of a row that is {level} and one that is not, the model gives the first the higher probability {percent}% of the time. 0.5 is a coin toss, 1 never wrong; above 0.8 is usually called good."
