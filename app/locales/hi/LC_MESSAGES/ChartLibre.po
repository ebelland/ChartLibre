msgid "Subtract minimum"
msgstr "न्यूनतम घटाएँ"

msgid "Subtract the median before scaling."
msgstr "स्केलिंग से पहले मीडियन को घटाएं।"

msgid "Suggestions"
msgstr "सुझाव"

msgid "Sum"
msgstr "योग"

