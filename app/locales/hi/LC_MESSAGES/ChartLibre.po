msgstr "सीधी रेखा"

msgid "Straight line between endpoints"
msgstr "एंडपॉइंट के बीच सीधी रेखा"

msgid "Strings"
msgstr "स्ट्रिंग्स"

msgid "Student t-test (equal variances)"
msgstr "छात्र टी - टेस्ट (समान भिन्नताएं)"

msgid "Study"
msgstr "अध्ययन"

