msgid "Std Dev {sd}: a typical value of {column} lies about {sd} from its mean, {mean}. If the shape is normal, about two thirds of the values lie within one Std Dev of it, 95% within two."
msgstr "STD DEV {sd}: {column} का एक विशिष्ट मान इसके औसत, {mean} से {sd} के बारे में है। यदि आकार सामान्य है, तो मानों का लगभग दो तिहाई इसके एक एसटीडी देव के भीतर है, जो दो के भीतर 95% है।"

msgid "Std. error"
msgstr "STD. त्रुटि"

