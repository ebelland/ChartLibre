msgstr "वेल्च टी - टेस्ट"

msgid "What do you want to find out?"
msgstr "आप क्या जानना चाहते हैं?"

msgid "What has the most impact on {measure} - {group} and the other columns, ranked"
msgstr "{measure} - {group} और रैंक किए गए अन्य कॉलम पर सबसे अधिक क्या प्रभाव पड़ता है"

msgid "What has the most impact on {measure}?"
msgstr "{measure} पर सबसे अधिक क्या प्रभाव पड़ता है?"

msgid "What has the most impact on {response}"
msgstr "{response} पर सबसे अधिक क्या प्रभाव पड़ता है"

