msgstr "Seconde coupure, pour une réponse passe-bande/coupe-bande."

msgid "Second cutoff:"
msgstr "Seconde coupure :"

msgid "Passband ripple, in dB (Chebyshev I / Elliptic)."
msgstr "Ondulation dans la bande passante, en dB (Tchebychev I / Elliptique)."

msgid "Ripple (dB):"
msgstr "Ondulation (dB) :"

