/* ==========================================================
   Fluent Win11 – ChartLibre 
   ========================================================== */

QMainWindow {
    background-color: palette(base);
}

/* main_window.py sets Qt.FramelessWindowHint on Windows, which strips every
   bit of native chrome - border, corner, drop shadow - so the window has no
   visible edge of its own against whatever is behind it without this. Plain
   1px outline, no radius: WinUI3 windows are only softly rounded by DWM at
   the compositor level, which a QSS border-radius on an opaaque child widget
   cannot reproduce (it would draw a rounded rectangle inside a still-square
   window, not reshape the window itself). */


QWidget#windowFrame {
  background: palette(base);
}

/* The navigation-rail toggle, left of the title: a flat glyph in the
   title bar rather than a framed button, the same subtle-fill-on-hover
   treatment WinUI3 gives its own caption-bar controls. */

QToolButton#titleBarSidebarButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    /* The generic QToolButton rule below asks for 36 px and 8 px of side
       padding, which pushed this glyph away from the traffic lights and
       below their line. A small square keeps it beside them. */
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}

QToolButton#titleBarSidebarButton:hover {
    background: rgba(@SHADOW_RGB@, 0.09);
}

QToolButton#titleBarSidebarButton:checked {
    background: rgba(@SHADOW_RGB@, 0.14);
}

/* The caption buttons (minimize / maximize / close) of the custom title
   strip: as tall as the strip, edge to edge, hover filling the whole button
   like a native Windows 11 caption - not the generic QToolButton box below
   (36 px minimum, rounded), which was taller than the strip and cut them off. */
QToolButton#titleBarButton,
QToolButton#titleBarCloseButton {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-width: 40px;
    max-width: 40px;
    min-height: 30px;
    max-height: 30px;
    icon-size: 12px;
}

QToolButton#titleBarButton:hover {
    background: rgba(@SHADOW_RGB@, 0.09);
}

QToolButton#titleBarButton:pressed {
    background: rgba(@SHADOW_RGB@, 0.14);
}

QToolButton#titleBarCloseButton:hover {
    background: #c42b1c;
}

QToolButton#titleBarCloseButton:pressed {
    background: #b22a1b;
}

/* ==========================================================
   Global Base
   ========================================================== */

* {
    outline: none;
    /* Resolved at load time by style.substitute_ui_font, against the fonts
       actually installed - not a static list. A list here would be a list
       of guesses, and every name in it that the machine does not have costs
       a full alias walk (~200 ms on Windows, with a Qt warning to match)
       before Qt reaches the one it does. See style.ui_font_family. */
    font-family: @UI_FONT_FAMILY@;
    font-size: 10pt;
}

/* No background here on purpose (used to be palette(window)): a bare
   QWidget selector matches every plain layout-only container in the
   app, and Qt auto-sets WA_StyledBackground on any widget a stylesheet
   rule names - so every unstyled row wrapper (a QHBoxLayout holding a
   couple of buttons, say) silently started painting a grey fill. Rows
   whose content happens to expand full-width (a QComboBox, a QLineEdit)
   hid it completely; rows that don't (two buttons plus a stretch, a
   lone checkbox) showed it as an unexplained grey stripe - reported
   against the Grid card's own Rows/Cols row. Real surfaces (cards,
   pages, the window frame) already set their own background
   explicitly; nothing needed this blanket one. */
QWidget {
    color: palette(window-text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QWidget:disabled {
    color: rgba(@NEUTRAL_RGB@, 0.70);
}


/* ==========================================================
   Fluent Surfaces / Cards / Acrylic
   ========================================================== */

QFrame,
QGroupBox {
    background: transparent;
}

/* Standard card surface.
   create_card_widget() (app/styles/style.py) sets the Qt *property*
   card=true and gives each card its own distinct objectName - it never
   names one literally "Card"/"card", so the #Card/#card rules below never
   matched a single one of them; every card-styled section in the app
   (axis/figure/series properties, and the rest) was falling straight
   through to the plain QFrame{background:transparent} rule above, with no
   surface, border or radius of its own. The [card="true"] property
   selector is what macos_native.qss already uses correctly for the same
   widgets. Kept the #Card/#card id rules too, in case something someday
   names a frame that literally rather than going through the helper. */
QFrame[card="true"],
QWidget[card="true"],
QFrame#Card,
QFrame#card,
QWidget#Card,
QWidget#card,
QFrame#ChartPanel {
    background: palette(base);
    border: 1px solid rgba(@SHADOW_RGB@, 0.07);
    border-radius: 12px;
}

/* The guided analysis: the Analysis panel's way in, tinted with the accent
   so it reads apart from the frames of analyses under it. */
QFrame#guidedAnalysisCard {
  background: rgba(@ACCENT_RGB@, 0.08);
  border: 1px solid rgba(@ACCENT_RGB@, 0.22);
}

/* The Figure/Axis/Series properties panels (BaseProperties).
   White, not the window grey: the cards inside are white too, so on grey
   the panel read as grey gutters between white boxes - a different colour
   in the margins, in the tab-bar strip and behind every gap. WinUI3's own
   Settings app is one continuous page with outlined cards sitting on it,
   which is what this makes it. macos_native.qss deliberately answers the
   other way, since System Settings floats its grouped boxes on grey. */
QWidget#basePropertiesPanel {
    background: palette(base);
}

/* Elevated card surface */
QFrame[elevated="true"],
QWidget[elevated="true"] {
    background: palette(base);
    border: 1px solid rgba(@SHADOW_RGB@, 0.08);
    border-radius: 14px;
}


/* The chart pane is a surface, not a card: its jump bar and tab strip run
   flush to its edges with square backgrounds of their own, which covered
   the rounded top corners and left the card's outline showing round
   behind square (todo W-02). Square, as macos_native.qss treats the same
   pane, keeping the outline that separates it from the left panel. */
QFrame#chartSurfaceCard {
    border-radius: 0px;
}

/* Acrylic-style panels.
   For best effect, enable translucent background in Python. */
QFrame#acrylicPanel,
QWidget#acrylicPanel,
QFrame[acrylic="true"],
QWidget[acrylic="true"] {
    background: rgba(@GLOW_RGB@, 0.72);
    border: 1px solid rgba(@GLOW_RGB@, 0.42);
    border-radius: 14px;
}

/* Dark acrylic variant */
QFrame[acrylicDark="true"],
QWidget[acrylicDark="true"] {
    background: rgba(32, 32, 32, 0.68);
    color: rgba(255, 255, 255, 0.92);
    /* Literal white, not @GLOW_RGB@: this panel is dark in every theme, so
       its own overlays must not follow the theme's light/dark direction. */
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 14px;
}

/* Sidebar acrylic */
QFrame#activityRail,
QFrame#sideBar,
QWidget#sideBar,


/* Transparent main containers */
QWidget#centralWidget,
QWidget#contentView,
QFrame#contentView {
    background: transparent;
    border: none;
}


/* ==========================================================
   Labels / Typography
   ========================================================== */

QLabel {
    background: transparent;
    color: palette(window-text);
}

QLabel[role="title"] {
    font-size: 20px;
    font-weight: 600;
}

QLabel[role="subtitle"] {
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="caption"] {
    color: rgba(@NEUTRAL_RGB@, 0.95);
    font-size: 9pt;
}

QLabel[muted="true"] {
    color: rgba(@NEUTRAL_RGB@, 0.95);
}


/* ==========================================================
   Fluent Icon Styling
   ========================================================== */

/* General icon labels */
QLabel[icon="true"],
QLabel[fluentIcon="true"] {
    background: transparent;
    color: palette(window-text);
    min-width: 20px;
    min-height: 20px;
    qproperty-alignment: AlignCenter;
}

/* Icon-only buttons */
QPushButton[iconOnly="true"],
QToolButton[iconOnly="true"],
QAbstractButton[iconOnly="true"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    icon-size: 20px;
}

QPushButton[iconOnly="true"]:hover,
QToolButton[iconOnly="true"]:hover,
QAbstractButton[iconOnly="true"]:hover {
    background: rgba(@SHADOW_RGB@, 0.045);
    border: 1px solid rgba(@SHADOW_RGB@, 0.04);
}

QPushButton[iconOnly="true"]:pressed,
QToolButton[iconOnly="true"]:pressed,
QAbstractButton[iconOnly="true"]:pressed {
    background: rgba(@SHADOW_RGB@, 0.085);
}

QPushButton[iconOnly="true"]:checked,
QToolButton[iconOnly="true"]:checked,
QAbstractButton[iconOnly="true"]:checked {
    background: rgba(@ACCENT_RGB@, 0.12);
    color: palette(highlight);
}

/* Accent icon buttons */
QToolButton[accent="true"],
QPushButton[accent="true"] {
    color: palette(highlight);
}

/* Remove menu indicator from icon buttons */
QToolButton::menu-indicator {
    width: 0;
    image: none;
}
/* ==========================================================
   Fluent Command Bar
   ========================================================== */

QToolBar {
    border: none;
    padding: 4px;
    spacing: 4px;
}

QToolBar::separator {
    background: rgba(@SHADOW_RGB@,0.06);
    margin: 6px 8px;
    width: 1px;
}

QToolButton {

    color: palette(window-text);
    border: 1px solid transparent;

    border-radius: 8px;

    padding: 0 8px;
    min-width: 36px;
    min-height: 36px;

    icon-size: 20px;
}

QToolButton:hover {
    background: rgba(@SHADOW_RGB@,0.045);
}

QToolButton:pressed {
    background: rgba(@SHADOW_RGB@,0.08);
}

QToolButton:checked {
    background: rgba(@ACCENT_RGB@,0.12);
    color: palette(highlight);
}

QToolButton::menu-indicator {
    image: none;
}

/* The buttons a QLineEdit makes for itself - the leading search icon, the
   clear button - are QToolButtons too, and the box above (36 px minimum, 8 px
   of side padding) made each one 54 x 38 inside a 32 px field: the icon sat
   below the field's bottom-left corner and the text was pushed right to make
   room for it. Back to the glyph's own size. */
QLineEdit QToolButton {
    min-width: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
}

/* -------------------------------
   Menus
-------------------------------- */

QMenu {
  background: palette(base);
  border: 1px solid rgba(@SHADOW_RGB@, 0.12);
  border-radius: 8px;
  padding: 6px;
}

QMenu::item {
  border-radius: 6px;
  padding: 6px 16px;
}

QMenu::item:selected {
  background: palette(highlight);
  color: palette(highlighted-text);
}

QMenu::separator {
  background: rgba(@SHADOW_RGB@, 0.08);
  margin: 6px 0;
  height: 1px;
}

/* ==========================================================
   Tabs
   ========================================================== */
/* ==========================================================
   Fluent 2 TabList
   Based on Microsoft Fluent 2 TabList behavior:
   - transparent tab surface
   - subtle hover
   - selected tab uses accent underline, not blue fill
   - compact but readable 36px touch target
   ========================================================== */

QTabWidget::pane {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(@SHADOW_RGB@, 0.10);
    padding: 0;
    margin: 0;
}

QTabWidget {
    background: transparent;
}

/* A hairline shelf under the whole strip - the selected tab's own
   bottom border below overpaints exactly its own width of it with the
   pane's background colour, the classic "notebook tab" trick that
   makes the selected tab read as fused to the content below it rather
   than sitting apart from it (WinUI3's own TabView look, not a floating
   underline-only tab as this file drew before). */
QTabBar {
      background: rgba(@SHADOW_RGB@, 0.05);
      border-radius: 8px;
      padding: 2px;
      qproperty-drawBase: 0;
  }
  /* Base tab */
  QTabBar::tab {
      background: transparent;
      color: palette(mid);
      border: none;
      border-radius: 4px;
      padding: 4px 14px;
      margin: 1px;
      min-width: 52px;
  }
  QTabBar QToolButton {
      min-width: 5px;
      min-height: 5px;
  }

/* Hover state */
QTabBar::tab:hover:!selected {
    background: rgba(@SHADOW_RGB@, 0.05);
    color: palette(window-text);
}

/* Selected tab: matches the pane's own background and sits flush
   against it (no gap, no border of its own on that edge) - the tab and
   the content it opens read as one connected surface, WinUI3-style,
   instead of a coloured underline floating below plain text. */
QTabBar::tab:selected {
      background: palette(base);
      color: palette(text);
      border: 1px solid rgba(@SHADOW_RGB@, 0.10);
      font-weight: 600;
  }

/* Pressed */
QTabBar::tab:pressed {
    background: rgba(@SHADOW_RGB@, 0.09);
}

/* Disabled */
QTabBar::tab:disabled {
    background: transparent;
    color: rgba(@NEUTRAL_RGB@, 0.65);
}

/* Focus approximation.
   Qt QSS cannot draw Fluent's true keyboard focus outline cleanly
   around tab text, so this uses a stronger underline. */
QTabBar::tab:focus:!selected {
    border-bottom: 2px solid palette(highlight);
}

/* First / last tab cleanup */
QTabBar::tab:first {
    margin-left: 0;
}

QTabBar::tab:last {
    margin-right: 0;
}
/* -------------------------------
   Buttons
-------------------------------- */

QPushButton {
  background: palette(button);
  border: 1px solid rgba(@SHADOW_RGB@, 0.12);
  border-radius: 8px;
  padding: 6px 14px;
}

QPushButton:hover {
  background: rgba(@SHADOW_RGB@, 0.05);
}

QPushButton:pressed {
  background: rgba(@SHADOW_RGB@, 0.08);
}

QPushButton:disabled {
  opacity: 0.5;
}

/* -------------------------------
   Inputs
-------------------------------- */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QPlainTextEdit,
QTextEdit {
  background: palette(base);
  color: palette(text);
  border: 1px solid rgba(@SHADOW_RGB@, 0.14);
  border-radius: 8px;
  padding: 6px 8px;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus {
  border: 1px solid palette(highlight);
}

/* -------------------------------
   ComboBox
-------------------------------- */

QComboBox {
  padding: 6px 30px 6px 10px;
}

QComboBox::drop-down {
  border: none;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
  width: 26px;
  subcontrol-origin: padding;
  subcontrol-position: top right;
}

QComboBox::drop-down:hover {
  background: rgba(@SHADOW_RGB@, 0.04);
}

/* The arrow has to be given: with the drop-down styled above, Qt stops
   drawing the platform's own. The Segoe Fluent chevron, rendered at start-up
   from the system font (@ICON:), so still no hand-drawn file. */
QComboBox::down-arrow {
  width: 10px;
  height: 10px;
  image: url(@ICON:chevron_down@);
}

/* Popup */
QComboBox QAbstractItemView {
  background: palette(base);
  color: palette(text);
  border: 1px solid rgba(@SHADOW_RGB@, 0.12);
  border-radius: 8px;
  padding: 6px;
}

QComboBox QAbstractItemView::item {
  border-radius: 6px;
  padding: 6px 10px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
  background: palette(highlight);
  color: white;
}

/* ==========================================================
   Fluent SpinBox
   ========================================================== */

QSpinBox,
QDoubleSpinBox {

    background: palette(base);
    color: palette(text);

    border: 1px solid rgba(@SHADOW_RGB@,0.10);

    border-radius: 8px;

    padding: 0 30px 0 10px;
    min-height: 30px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border: 1px solid rgba(@ACCENT_RGB@,0.25);
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid palette(highlight);
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background: transparent;

    border: none;
    width: 22px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: rgba(@ACCENT_RGB@,0.06);
}

/* The arrows have to be given: once the buttons above are styled, Qt's
   stylesheet engine stops drawing the platform's own and the buttons come
   out empty (UI-07). The Segoe Fluent chevrons, rendered at start-up, as
   macos_native.qss gives the SF Symbols ones. */
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 9px;
    height: 9px;
    image: url(@ICON:chevron_up@);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 9px;
    height: 9px;
    image: url(@ICON:chevron_down@);
}

QSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: none;
}



/* -------------------------------
   Table / Lists
-------------------------------- */

QTableView,
QListView,
QTreeView {
  background: palette(base);
  color: palette(text);
  border: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 8px;
}

/* Hover must stay readable on accent backgrounds */
QTableView::item:hover,
QListView::item:hover,
QTreeView::item:hover,
QAbstractItemView::item:hover {
  background: palette(highlight);
  color: white;
}

/* Selected items */
QAbstractItemView::item:selected,
QAbstractItemView::item:selected:active,
QTableView::item:selected,
QListView::item:selected,
QTreeView::item:selected {
  background: palette(highlight);
  color: white;
}

QHeaderView::section {
  background: transparent;
  padding: 6px;
}

/* -------------------------------
   Scrollbars (clean Fluent)
-------------------------------- */

QScrollBar:vertical {
  background: transparent;
  margin: 0;
  width: 10px;
}

QScrollBar::handle:vertical {
  background: rgba(@SHADOW_RGB@, 0.25);
  border-radius: 5px;
  min-height: 40px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(@SHADOW_RGB@, 0.35);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  background: none;
  border: none;
  width: 0px;
  height: 0px;
}

QScrollBar::up-arrow,
QScrollBar::down-arrow {
  width: 0px;
  height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: transparent;
}

QScrollBar:horizontal {
  background: transparent;
  margin: 0;
  height: 10px;
}

QScrollBar::handle:horizontal {
  background: rgba(@SHADOW_RGB@, 0.25);
  border-radius: 5px;
  min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
  background: rgba(@SHADOW_RGB@, 0.35);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  background: none;
  border: none;
  width: 0px;
  height: 0px;
}

QScrollBar::left-arrow,
QScrollBar::right-arrow {
  width: 0px;
  height: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: transparent;
}

/* -------------------------------
   Message boxes / dialogs
-------------------------------- */

QMessageBox {
  background: palette(window);
}

/* Reduce forced width to avoid overly wide message boxes */
QMessageBox QLabel {
  min-width: 0px;
  max-width: 360px;
}

/* -------------------------------
   Status bar
-------------------------------- */

QStatusBar {
  background: transparent;
  border-top: 1px solid rgba(@SHADOW_RGB@, 0.06);
}

/* -------------------------------
   Radio buttons
-------------------------------- */

QRadioButton {
  background: transparent;
  color: palette(text);
  border: none;
  spacing: 6px;
}

/* A checked box: a white tick on the highlight colour (the native one drew it
   dark on blue, which has no contrast). */
QCheckBox::indicator {
  width: 14px;
  height: 14px;
}

QCheckBox::indicator:unchecked {
  background: palette(base);
  border: 1px solid palette(mid);
  border-radius: 4px;
}

QCheckBox::indicator:checked {
  background: palette(highlight);
  border: 1px solid palette(highlight);
  border-radius: 4px;
  image: url(@ICON:checkbox_tick@);
}

QCheckBox::indicator:indeterminate {
  background: palette(highlight);
  border: 1px solid palette(highlight);
  border-radius: 4px;
}

QRadioButton::indicator {
  width: 14px;
  height: 14px;
}

QRadioButton::indicator:unchecked {
  background: palette(base);
  border: 1px solid palette(mid);
  border-radius: 7px;
}

QRadioButton::indicator:checked {
  background: palette(highlight);
  border: 1px solid palette(mid);
  border-radius: 7px;
}

/* -------------------------------
   TableListPanel
-------------------------------- */

TableListPanel QTableView {
  background: palette(base);
  color: palette(text);
  border: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 8px;
  gridline-color: rgba(@SHADOW_RGB@, 0.06);
}

TableListPanel QTableView::item {
  padding: 2px 8px;
}

/* One colour across the whole row.  The view's own selection fill and the
   item's fill have to name the same colour, or the cells and the gaps between
   them come out as two different blues. */
TableListPanel QTableView {
  selection-background-color: palette(highlight);
  selection-color: palette(highlighted-text);
}

TableListPanel QTableView::item:selected,
TableListPanel QTableView::item:selected:active,
TableListPanel QTableView::item:selected:!active {
  background: palette(highlight);
  color: palette(highlighted-text);
}

TableListPanel QHeaderView::section {
  background: palette(window);
  color: palette(window-text);
  border: none;
  border-right: 1px solid rgba(@SHADOW_RGB@, 0.06);
  border-bottom: 1px solid rgba(@SHADOW_RGB@, 0.08);
  padding: 5px 8px;
  font-size: 8pt;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

TableListPanel QHeaderView::section:last {
  border-right: none;
}

/* -------------------------------
   Data tables (preview, table editor): QTableView#dataTable
-------------------------------- */

QTableView#dataTable {
  background: palette(base);
  color: palette(text);
  border: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 8px;
  gridline-color: rgba(@SHADOW_RGB@, 0.06);
}

QTableView#dataTable::item {
  padding: 2px 8px;
}

QTableView#dataTable QHeaderView::section {
  background: palette(window);
  color: palette(window-text);
  border: none;
  border-right: 1px solid rgba(@SHADOW_RGB@, 0.06);
  border-bottom: 1px solid rgba(@SHADOW_RGB@, 0.08);
  padding: 5px 8px;
  font-size: 8pt;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

QTableView#dataTable QHeaderView::section:last {
  border-right: none;
}

/* Row numbers (the table editor shows them): a quiet gutter. */
QTableView#dataTable QHeaderView::section:vertical,
QTableView#dataTable QHeaderView::section:vertical:last {
  border-right: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-bottom: none;
  padding: 0 8px;
  font-weight: 400;
  letter-spacing: 0;
}

/* -------------------------------
   Activity rail / navigation (NavigationBar, app/widgets/nav_bar.py)
   A column of rows (#navigationItem): the icon, then its label to the
   right, left-aligned, in the application's ordinary font - no size of
   its own, no weight change on the selected row (a bold label is wider than
   a regular one, and the row's text moved when it was chosen). The Windows
   11 selection mark: a tinted row with a short accent bar on its left.
-------------------------------- */

QFrame#activityRail {
    background: palette(window);
    border: none;
    border-right: 1px solid palette(midlight);
}

QToolButton#navigationItem {
    background: transparent;
    color: palette(window-text);
    border: none;
    border-radius: 6px;
    padding: 0 10px;
    text-align: left;
}

QToolButton#navigationItem:hover {
    background: palette(midlight);
}

QToolButton#navigationItem:pressed {
    background: palette(mid);
}

QToolButton#navigationItem:checked {
    background: palette(button);
    color: palette(window-text);
    /* The bar takes 3 px of the 10 px padding, so the icon stays put. */
    border-left: 3px solid palette(highlight);
    padding-left: 7px;
}

QToolButton#navigationItem::menu-indicator {
    width: 0px;
    image: none;
}

  /* ==========================================================
   Fluent Primary Buttons
   ========================================================== */

QPushButton[primary="true"],
QPushButton[accent="true"] {
    background: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    font-weight: 600;
}

QPushButton[primary="true"]:hover,
QPushButton[accent="true"]:hover {
    background: rgba(@ACCENT_RGB@,0.92);
}

QPushButton[primary="true"]:pressed,
QPushButton[accent="true"]:pressed {
    background: rgba(@ACCENT_RGB@,0.82);
}

QPushButton[primary="true"]:disabled,
QPushButton[accent="true"]:disabled {
    background: rgba(@NEUTRAL_RGB@,0.18);
    color: rgba(@NEUTRAL_RGB@,0.70);
    border: 1px solid rgba(@NEUTRAL_RGB@,0.15);
}

/* ==========================================================
   Destructive buttons - "Clear list" and anything else that
   forgets/deletes rather than opens/saves. Windows 11's own
   SystemFillColorCritical red, not the theme's accent color: a
   destructive action reads the same regardless of accent choice.
   ========================================================== */

QPushButton[destructive="true"] {
    background: #C42B1C;
    color: white;
    border: 1px solid #C42B1C;
    font-weight: 600;
}

QPushButton[destructive="true"]:hover {
    background: #A4262C;
    border: 1px solid #A4262C;
}

QPushButton[destructive="true"]:pressed {
    background: #8E2019;
    border: 1px solid #8E2019;
}

QPushButton[destructive="true"]:disabled {
    background: rgba(@NEUTRAL_RGB@,0.18);
    color: rgba(@NEUTRAL_RGB@,0.70);
    border: 1px solid rgba(@NEUTRAL_RGB@,0.15);
}

/* ==========================================================
   Dialog ButtonBox Primary Buttons
   ========================================================== */

QDialogButtonBox QPushButton {
    min-width: 88px;
}

/* Explicit selector for dialog buttons */
QDialogButtonBox QPushButton[primary="true"],
QMessageBox QPushButton[primary="true"],
QPushButton[primary="true"] {
    background: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    font-weight: 600;
}

QDialogButtonBox QPushButton[primary="true"]:hover,
QMessageBox QPushButton[primary="true"]:hover,
QPushButton[primary="true"]:hover {
    background: rgba(@ACCENT_RGB@, 0.92);
    color: white;
    border: 1px solid rgba(@ACCENT_RGB@, 0.92);
}

QDialogButtonBox QPushButton[primary="true"]:pressed,
QMessageBox QPushButton[primary="true"]:pressed,
QPushButton[primary="true"]:pressed {
    background: rgba(@ACCENT_RGB@, 0.82);
    color: white;
    border: 1px solid rgba(@ACCENT_RGB@, 0.82);
}

/* ==========================================================
   Fluent Dialog Primary Button
   Must be at the very end of the stylesheet
   ========================================================== */

QPushButton#primaryDialogButton {
    background: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
    border-radius: 8px;
    padding: 6px 14px;
    min-width: 88px;
    min-height: 30px;
    font-weight: 600;
}

QPushButton#primaryDialogButton:hover {
    background: rgba(@ACCENT_RGB@, 0.92);
    color: white;
    border: 1px solid rgba(@ACCENT_RGB@, 0.92);
}

QPushButton#primaryDialogButton:pressed {
    background: rgba(@ACCENT_RGB@, 0.82);
    color: white;
    border: 1px solid rgba(@ACCENT_RGB@, 0.82);
}

QPushButton#primaryDialogButton:disabled {
    background: rgba(@NEUTRAL_RGB@, 0.18);
    color: rgba(@NEUTRAL_RGB@, 0.70);
    border: 1px solid rgba(@NEUTRAL_RGB@, 0.15);
    font-weight: 400;
}

QDialogButtonBox QPushButton {
    min-width: 88px;
}
/* ==========================================================
   Fluent 2 ToolBox
   ========================================================== */

QToolBox {
    background: transparent;
    border: none;
}

QToolBox::tab 
{
    background: rgba(@NEUTRAL_RGB@, 0.08);
    border: 0;
    border-radius: 6px;
    padding: 6px 8px;
    font-weight: 600;
    text-align: left;
}
/* Hover */
QToolBox::tab:hover {
    background: rgba(@SHADOW_RGB@, 0.045);
}

/* Selected */
QToolBox::tab:selected {
    background: rgba(@ACCENT_RGB@, 0.055);
    color: palette(window-text);
    font-weight: 600;
}

/* Pressed */
QToolBox::tab:pressed {
    background: rgba(@ACCENT_RGB@, 0.08);
}

/* Disabled */
QToolBox::tab:disabled {
    color: rgba(@NEUTRAL_RGB@, 0.70);
}

/* A page is the white page WinUI3 puts its outlined cards on - the
   opposite answer to macos_native.qss's grey ground, and deliberately so:
   see that file's note on #basePropertiesPanel. Stated rather than
   inherited, because a page with no rule takes whatever is behind it. */
QWidget[toolboxPage="true"] {
    background: palette(base);
}

/* A data operation's Settings frame (B-14): its tab pages and the cards on
   them take the frame's own surface - one box, not a box in a box. */
QFrame#operationSettingsCard QWidget[toolboxPage="true"],
QFrame#operationSettingsCard QFrame[card="true"],
QFrame#operationSettingsCard QWidget[card="true"] {
  background: transparent;
  border: none;
}


QDialog
{
  padding: 6px 8px;
}

/* ==========================================================
   Fluent 2 / macOS Command List
   DataOperationWidget
   ========================================================== */

/* ----------------------------------------------------------
   Section headers
   ---------------------------------------------------------- */

QLabel[sectionTitle="true"] {

    color: rgba(@NEUTRAL_RGB@, 0.9);

    padding-top: 8px;
    padding-bottom: 4px;

    font-size: 9pt;

    font-weight: 600;

    letter-spacing: 0.04em;

    text-transform: uppercase;
}

/* ----------------------------------------------------------
   Operation list (sectioned, like the navigation rail's chart
   list): section titles are disabled items, rows carry the
   operation's icon and name, hover and selection are a rounded
   neutral tint as in a Fluent NavigationView.
   ---------------------------------------------------------- */

QLineEdit#dataOperationsSearch {
    margin: 10px 10px 4px 10px;
}

QListWidget#dataOperationsList {
    background: palette(base);
    border: none;
    padding: 0 6px;
    outline: 0;
}

QListWidget#dataOperationsList::item {
    color: palette(window-text);
    border-radius: 4px;
    padding: 0 4px;
}

QListWidget#dataOperationsList::item:disabled {
    background: transparent;
    color: rgba(@NEUTRAL_RGB@, 0.9);
}

QListWidget#dataOperationsList::item:hover:enabled {
    background: rgba(@SHADOW_RGB@, 0.05);
}

QListWidget#dataOperationsList::item:selected {
    background: rgba(@SHADOW_RGB@, 0.09);
    color: palette(window-text);
}

/* ----------------------------------------------------------
   Operation hint bar
   Fixed at the panel's bottom, outside the scroll area - see
   DataOperationWidget. A hairline top border marks it as its
   own strip rather than the last section bleeding into it.
   ---------------------------------------------------------- */

QLabel#operationHint {
    background: palette(base);
    border-top: 1px solid rgba(@SHADOW_RGB@, 0.08);
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    padding: 8px 10px;
}

/* The Edit table dialog's "more" button opens a menu; its icon already
   says so, so no drop-down arrow beside it. */
QToolButton#tableEditorMore {
  background: transparent;
  border: none;
  padding: 4px;
}

QToolButton#tableEditorMore::menu-indicator {
  width: 0px;
  image: none;
}

/* A setting whose "off" is risky (Settings > SQL guard): red text. */
QCheckBox[destructive="true"] {
  color: #FF3B30;
}

/* Sidebar sections and the chart list (the charts used to be tabs). */
/* NavigationBar's scrolling list of sections: no background of its own,
   so the rail's shows through - a scroll area otherwise paints the window
   colour, a grey block inside the rail. */
QScrollArea#navSections,
QScrollArea#navSections > QWidget#qt_scrollarea_viewport,
QWidget#navSectionsBody {
  background: transparent;
  border: none;
}

QLabel#navSectionTitle {
  color: rgba(@SHADOW_RGB@, 0.55);
  padding: 6px 6px 2px 6px;
  font-weight: 600;
}

QListWidget#chartList {
  background: transparent;
  border: none;
  outline: 0;
}

QListWidget#chartList::item {
  border-radius: 4px;
  padding: 0 4px;
  min-height: 28px;
}

QListWidget#chartList::item:selected {
  background: rgba(@SHADOW_RGB@, 0.09);
  color: palette(text);
}

QFrame#chartJumpBar {
  background: palette(base);
  border-bottom: 1px solid rgba(@SHADOW_RGB@, 0.12);
}

QToolButton#chartJumpTitle {
  border: none;
  font-weight: 600;
}

/* Chart toolbar, jump-bar arrows and title: small square hover areas. The
   generic QToolButton rule (36 px minimum, 8 px side padding) made them
   wide grey slabs and pushed the arrows out of the jump bar. */
QToolButton#chartToolButton {
  border-radius: 6px;
  padding: 0;
  min-width: 32px;
  max-width: 32px;
  min-height: 32px;
  max-height: 32px;
}

QToolButton#chartJumpArrow {
  border: none;
  border-radius: 6px;
  padding: 0;
  min-width: 28px;
  max-width: 28px;
  min-height: 28px;
  max-height: 28px;
}

QToolButton#chartJumpTitle {
  padding: 0 6px;
  min-width: 0;
  min-height: 28px;
  max-height: 28px;
}


/* A combo opened as a cell editor (the property editors): opaque, or the
   cell's own text shows through the see-through pop-up button above. */
QComboBox[cellEditor="true"],
QComboBox[cellEditor="true"]:hover,
QComboBox[cellEditor="true"]:on {
  background-color: palette(base);
}

/* Table editor: the tools are rows of a list inside their titled frames -
   flat, an icon and a name, a soft highlight under the pointer - not the
   framed squares the generic QToolButton rule draws. */
QToolButton#tableEditorTool,
QToolButton#tableEditorMore {
  background: transparent;
  border: none;
  border-radius: 6px;
  padding: 2px 6px;
  min-width: 0px;
  min-height: 0px;
  text-align: left;
}

QToolButton#tableEditorTool:hover,
QToolButton#tableEditorMore:hover {
  background: rgba(@SHADOW_RGB@, 0.07);
}

QToolButton#tableEditorTool:pressed,
QToolButton#tableEditorMore:pressed {
  background: rgba(@ACCENT_RGB@, 0.16);
}

QToolButton#tableEditorMore::menu-indicator {
  width: 0px;
  image: none;
}

QScrollArea#tableEditorToolsScroll,
QScrollArea#tableEditorToolsScroll > QWidget > QWidget {
  background: transparent;
}


/* Splitter gutters belong to the page surface, not to the neutral chrome. */
QSplitter::handle,
QSplitter::handle:horizontal,
QSplitter::handle:vertical {
    background: palette(base);
    border: none;
}

/* Remove the light pane outline and any residual right edge. */
QTabWidget,
QTabWidget::pane {
    background: transparent;
    border: none;
    border-right: none;
}

/* Rounded navigation surface. */
QFrame#activityRail {
    border: none;
    border-right: 1px solid palette(midlight);
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

/* New Plot: series controls should read as one framed, white list surface.
   Multiple object names are supported so the rule remains effective across
   the current editor implementations without affecting generic scroll areas. */
QScrollArea#seriesScrollArea,
QScrollArea#newPlotSeriesScrollArea,
QScrollArea#seriesOptionsScrollArea,
QFrame#seriesScrollFrame,
QWidget#seriesScrollFrame {
    background: palette(base);
    border: 1px solid rgba(@SHADOW_RGB@, 0.08);
    border-radius: 8px;
}

QScrollArea#seriesScrollArea > QWidget#qt_scrollarea_viewport,
QScrollArea#newPlotSeriesScrollArea > QWidget#qt_scrollarea_viewport,
QScrollArea#seriesOptionsScrollArea > QWidget#qt_scrollarea_viewport,
QScrollArea#seriesScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea#newPlotSeriesScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea#seriesOptionsScrollArea QWidget#qt_scrollarea_viewport {
    background: palette(base);
    border: none;
    border-radius: 8px;
}

QScrollArea#seriesScrollArea QWidget#qt_scrollarea_viewport > QWidget,
QScrollArea#newPlotSeriesScrollArea QWidget#qt_scrollarea_viewport > QWidget,
QScrollArea#seriesOptionsScrollArea QWidget#qt_scrollarea_viewport > QWidget {
    background: palette(base);
    border: none;
}
