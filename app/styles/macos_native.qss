QMainWindow {
    background-color:palette(base);
}

/* Frameless window's own edge (FramelessWindowHint strips every bit of
   native chrome - border, corner, drop shadow). Rounded to match real
   macOS windows; the radius here has to match WINDOW_CORNER_RADIUS in
   style.py by hand (Qt cannot read a border-radius back out of an
   applied stylesheet) - apply_rounded_window_mask() is what actually
   clips the window's content to this same rounded shape, since QSS
   border-radius alone only rounds what this widget itself paints, not
   its children. This is the *fallback* path only, for when
   apply_native_macos_corner_radius (see the rule right below) could not
   run - pyobjc missing, most likely. */
QWidget#windowFrame {
  background: palette(window);
  border: 1px solid rgba(@SHADOW_RGB@, 0.28);
  border-radius: 6px;
}

/* Once MainWindow.showEvent has successfully handed rounding to the real
   NSWindow's own CALayer (apply_native_macos_corner_radius, in
   app/styles/style.py), this fill and border must go back to being a
   plain rectangle: the corner curve above and the native clip are two
   independent anti-aliased curves at the same nominal radius but
   different rendering paths, so they do not fall on the same pixels -
   the mismatch showed as a doubled edge, a square corner from this rule
   peeking out past the native curve. Left square here, the *one* native
   clip rounds this along with everything else in the window, so only
   one curve ever reaches the screen. */
QWidget#windowFrame[nativeRounded="true"] {
  border-radius: 0;
}

QLabel[role="title"] {
  font-size: 17pt;
  font-weight: 600;
}

QLabel[role="subtitle"] {
  font-size: 15pt;
  font-weight: 500;
}

QLabel[role="caption"] {
  font-size: 11pt;
  color: palette(mid);
}

QLabel[muted="true"] {
  color: palette(mid);
}

QLabel[sectionTitle="true"] {
  font-size: 11pt;
  font-weight: 600;
  color: palette(window-text);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 2px 0 4px 0;
}


QFrame[card="true"],
QWidget[card="true"] {
  /* Lighter than a plain button now sitting on it (see QPushButton
     below): System Settings' grouped boxes read as barely tinted
     against the white page, with the button inside carrying the
     visible grey — not the reverse, which palette(window) gave here
     before (palette(button) resolves lighter than palette(window) in
     the light palette, so a plain button used to read lighter than
     the card around it). */
  background: rgba(@SHADOW_RGB@, 0.02);
  border-radius: 12px;
}

/* Pure white, not the generic card's faint tint: this one card is a
   page-sized surface holding the whole chart tab strip and its content
   (the style demo's own equivalent is a plain toolboxPage="true" ground,
   not a card), not a small grouped box - the 2% tint elsewhere framed
   the tab widget in a barely-there grey margin that read as a panel
   sitting behind it. */
QFrame#chartSurfaceCard {
  background: palette(base);
}

QWidget#basePropertiesPanel {
  background: palette(base);
}

/* A page is the white ground the grey cards float on - the same answer
   fluent_win11.qss gives (see test_both_sheets_say_what_a_toolbox_page_is).
   Without this, apply_toolbox_page_metrics's own toolboxPage="true"
   property - and every page in main_window.py that sets it by hand
   (File, Database, Developer) - had nothing to bind to and stayed
   whatever was behind them. */
QWidget[toolboxPage="true"] {
  background: palette(base);
}

QWidget[editorPanel="true"],
QAbstractItemView[editorPanel="true"] {
  background: palette(base);
  border: 1px solid rgba(@SHADOW_RGB@, 0.10);
  border-radius: 8px;
}

QGroupBox {
  background: transparent;
  border: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 10px;
  margin-top: 10px;
  padding-top: 8px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 4px;
  color: palette(mid);
  font-size: 11pt;
  font-weight: 600;
}


QAbstractButton[iconOnly="true"] {
  background: transparent;
  border: none;
  border-radius: 6px;
  padding: 4px;
  min-width: 28px;
  min-height: 28px;
  icon-size: 20px 20px;
}

QPushButton {
  /* A visibly grey pill against the now-lighter card (see
     [card="true"] above), not palette(button)'s near-white — that
     used to read lighter than the card it sat on. */
  background: rgba(@SHADOW_RGB@, 0.06);
  color: palette(button-text);
  border-radius: 6px;
  padding: 4px 14px;
  min-height: 15px;
}


QPushButton {
  icon-size: 0px 0px;
}

QPushButton:hover {
  background: rgba(@SHADOW_RGB@, 0.10);
}

QPushButton:pressed {
  background: rgba(@SHADOW_RGB@, 0.16);
}

QPushButton:disabled {
  color: palette(mid);
  border-color: rgba(@SHADOW_RGB@, 0.10);
}


QPushButton[primary="true"],
QPushButton[accent="true"],
QPushButton#primaryDialogButton {
  background: palette(highlight);
  color: palette(highlighted-text);
  border: 1px solid palette(highlight);
  border-radius: 6px;
  padding: 4px 14px;
  min-height: 15px;
  font-weight: 600;
}

QPushButton[primary="true"]:disabled,
QPushButton[accent="true"]:disabled,
QPushButton#primaryDialogButton:disabled {
  background: rgba(@SHADOW_RGB@, 0.10);
  border-color: rgba(@SHADOW_RGB@, 0.10);
  color: palette(mid);
}

/* Destructive buttons - "Clear list" and anything else that forgets/
   deletes rather than opens/saves. AppKit's own systemRed, not the
   theme's accent color - the same reason the traffic lights in
   custom_title_bar.py are not theme-dependent either. */
QPushButton[destructive="true"] {
  background: #FF3B30;
  color: white;
  border: 1px solid #FF3B30;
  border-radius: 6px;
  padding: 4px 14px;
  min-height: 15px;
  font-weight: 600;
}

QPushButton[destructive="true"]:hover {
  background: #E0342A;
  border: 1px solid #E0342A;
}

QPushButton[destructive="true"]:pressed {
  background: #C52E25;
  border: 1px solid #C52E25;
}

QPushButton[destructive="true"]:disabled {
  background: rgba(@SHADOW_RGB@, 0.10);
  border-color: rgba(@SHADOW_RGB@, 0.10);
  color: palette(mid);
}

QToolBox {
  background: transparent;
  border: none;
}

QToolBox::tab {
  text-align: left;
  padding: 10px 14px 8px 14px;
  min-height: 22px;
  border: none;
  border-bottom: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 0;
  background: transparent;
  font-weight: 600;
  font-size: 11pt;
  letter-spacing: 0;
  color: palette(mid);
}

QToolBox::tab:hover {
  background: rgba(@SHADOW_RGB@, 0.04);
  color: palette(text);
}

QToolBox::tab:selected {
  background: transparent;
  color: rgba(@ACCENT_RGB@, 1.0);
  border-bottom: 2px solid rgba(@ACCENT_RGB@, 0.85);
}

QToolBox::tab:selected:hover {
  background: rgba(@ACCENT_RGB@, 0.06);
}

QToolBox::tab:disabled {
  color: palette(mid);
}


QDialog {
  background: palette(base);
}

/* -------------------------------
   Chart panel
-------------------------------- */

QFrame#ChartPanel {
  /* White, not the grey window ground: everything else (cards, toolbox
     pages, the series-operations content) reads as one white surface
     now, and this was the one panel still showing palette(window)'s
     grey wherever the toolbar row or the canvas did not fully cover it -
     a grey panel behind the chart. */
  background: palette(base);
  border: none;
  border-radius: 0;
}

QToolBar {
  /*background: transparent;*/
  border: none;
  border-bottom: none;
  spacing: 2px;
}

QToolBar::separator {
  background: rgba(@SHADOW_RGB@, 0.10);
  width: 1px;
  margin: 4px 6px;
}

QToolButton#chartToolButton {
  background: transparent;
  border: none;
  border-radius: 6px;
  padding: 3px;
}

QToolButton#chartToolButton:hover {
  background: rgba(@SHADOW_RGB@, 0.06);
}

QToolButton#chartToolButton:checked {
  background: rgba(@ACCENT_RGB@, 0.16);
}

QToolButton#zoom_fitButton {
  background: transparent;
  border: none;
  border-radius: 6px;
  padding: 3px;
}

QToolButton#zoom_fitButton:hover {
  background: rgba(@SHADOW_RGB@, 0.06);
}


/* Native macOS segmented-control tabs: a single toned track holding
   equal-height segments, the selected one a flat white pill with a
   hairline border — not the earlier bevel trick (a lit top edge +
   darker bottom edge to fake a drop shadow), which read as a raised
   button rather than an AppKit tab. */

QTabWidget::pane {
  border: none;
  background: transparent;
}

QTabBar {
  background: rgba(@SHADOW_RGB@, 0.05);
  border-radius: 8px;
  padding: 2px;
  qproperty-drawBase: 0;
}

QTabBar::tab {
  background: transparent;
  color: palette(mid);
  border: none;
  border-radius: 4px;
  padding: 4px 14px;
  margin: 1px;
  /* Deliberately small: a large min-width would put a floor under the
     whole chart pane (see _configure_tabs). */
  min-width: 52px;
}

QTabBar::tab:hover:!selected {
  color: palette(text);
}

QTabBar::tab:selected {
  background: palette(base);
  color: palette(text);
  border: 1px solid rgba(@SHADOW_RGB@, 0.10);
  font-weight: 600;
}

QTabBar::tab:selected:hover {
  background: palette(base);
}

QTabBar::tab:disabled {
  color: palette(mid);
}

QTabBar::close-button {
  subcontrol-position: right;
  margin: 0 2px;
}

QTabBar QToolButton {
  background: transparent;
  border: none;
  border-radius: 6px;
  margin: 3px 1px;
}

QTabBar QToolButton:hover {
  background: rgba(@SHADOW_RGB@, 0.06);
}

/* Tahoe's System Settings sidebar: a grey column with a hairline on
   its own right edge, separating it from the white list/content beside
   it — not flush with whatever sits next to it. */
QFrame#activityRail {
  background: rgba(@SHADOW_RGB@, 0.035);
  border: none;
  border-right: 1px solid rgba(@SHADOW_RGB@, 0.08);
}

/* The title bar strip (see main_window._create_central_host) sits right
   above #activityRail, unstyled by default - without a rule here it shows
   #windowFrame's own white background instead, one shade off from the
   rail's own tint directly below it. Same tint, so the traffic lights read
   as part of one continuous grey band with the rail, not a separate white
   strip glued on top of it. */
QFrame#customTitleBar {
  background: rgba(@SHADOW_RGB@, 0.035);
  border: none;
}


QToolButton#navigationItem {
  background: transparent;
  border: none;
  border-radius: 6px;
  padding: 0 10px;
  text-align: left;
  font-size: 13pt;
}

QToolButton#navigationItem:hover {
  background: rgba(@SHADOW_RGB@, 0.06);
}

QToolButton#navigationItem:pressed {
  background: rgba(@SHADOW_RGB@, 0.10);
}

QToolButton#navigationItem:checked {
  background: rgba(@ACCENT_RGB@, 0.16);
  color: palette(highlight);
  font-weight: 600;
}

QToolButton#navigationItem:checked:hover {
  background: rgba(@ACCENT_RGB@, 0.22);
}

QToolButton#navigationItem::menu-indicator {
  image: none;
  width: 0px;
}

/* -------------------------------
   Chart navigation toolbar (#chartToolbar)
   NavigationToolbar2QT is built by Matplotlib, not us — its
   buttons, separators, and coordinate label come in as bare,
   unstyled Qt controls (native bezel buttons, a grooved
   separator line, plain label text). Tagged in chart_panel.py
   so they can be flattened to match the rest of the app's
   chrome: borderless icon buttons, translucent accent capsule
   for the active Pan/Zoom tool (same recipe as the activity
   rail), a hairline separator instead of a native groove, and
   a muted caption-sized coordinate readout.
-------------------------------- */

QLabel#chartCoordLabel {
  color: palette(text);
  font-size: 11pt;
  padding: 0 6px;
}

/* -------------------------------
   Properties split control
   Each CollapsiblePanel reads as a single rounded card (same
   language as ChartPanel/TableListPanel below), with a flat
   disclosure-triangle header — like the Format inspector in
   Pages/Keynote — instead of a bezeled push button. The toggle
   button is set autoRaise=True in Python so macOS doesn't draw
   its native button bezel/font over this; the rules below just
   add the rounded-card chrome and hover feedback.
-------------------------------- */

QFrame#collapsiblePanel {
  background: palette(base);
  border: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 10px;
}

QToolButton#panelToggleButton {
  text-align: left;
  padding: 8px 10px;
  border: none;
  border-radius: 6px;
  background: transparent;
  font-weight: 600;
}

QToolButton#panelToggleButton:hover {
  background: rgba(@SHADOW_RGB@, 0.05);
}

QToolButton#panelToggleButton:pressed {
  background: rgba(@SHADOW_RGB@, 0.09);
}

QWidget#panelBody {
  background: transparent;
}

/* leftPanelCard: the activity rail plus the content stack beside it
   (Tables/Properties/Database/...), flush against the chart panel to
   its right — not a floating rounded card. White, with a hairline on
   its own right edge, is the "list column" Mail/Finder/System Settings
   put next to their own grey sidebar; #activityRail above draws that
   grey sidebar as its own region inside this same white panel. Needs
   an id rule (not just the QWidget[card="true"] one above) to win: a
   CardFrame always carries the card="true" property too. */
QFrame#leftPanelCard {
  background: palette(base);
  border: none;
  border-right: 1px solid rgba(@SHADOW_RGB@, 0.10);
  border-radius: 0;
}

/* Finder's divider is a hairline you aim at, not a visible bar. */
QSplitter::handle {
  background: transparent;
}

QSplitter::handle:horizontal {
  width: 6px;
}

QSplitter::handle:vertical {
  height: 6px;
  /* The one divider that is drawn: between the file list and the
     preview underneath it, as in a Finder column split. */
  border-top: 1px solid rgba(@SHADOW_RGB@, 0.08);
}


TableListPanel QTableView {
  background: palette(base);
  alternate-background-color: rgba(@SHADOW_RGB@, 0.03);
  color: palette(text);
  border: none;
  border-radius: 0;
  gridline-color: transparent;
  /* Finder's sidebar rows are taller than a data grid's. */
  show-decoration-selected: 1;
  /* The capsule below is the only thing that paints a selected row.  Left at
     the default, the view fills the whole row rect with the highlight colour
     and the capsule sits on top of it, so the 6px margin either side shows as
     a second, darker blue. */
  selection-background-color: transparent;
  selection-color: palette(highlighted-text);
}

TableListPanel QTableView::item {
  padding: 4px 8px;
  border-radius: 6px;
  margin: 1px 6px;
}

TableListPanel QTableView::item:selected,
TableListPanel QTableView::item:selected:active,
TableListPanel QTableView::item:selected:!active {
  background: palette(highlight);
  color: palette(highlighted-text);
}

TableListPanel QHeaderView::section {
  background: transparent;
  color: rgba(@SHADOW_RGB@, 0.65);
  font-size: 11pt;
  font-weight: 600;
  letter-spacing: 0;
  padding: 4px 10px;
  border: none;
}

TablePreviewPanel QTableView {
  background: palette(base);
  alternate-background-color: rgba(@SHADOW_RGB@, 0.03);
  color: palette(text);
  border: none;
  border-top: 1px solid rgba(@SHADOW_RGB@, 0.08);
  border-radius: 0;
  gridline-color: transparent;
  selection-background-color: transparent;
  selection-color: palette(highlighted-text);
}

TablePreviewPanel QTableView::item {
  padding: 2px 8px;
}

TablePreviewPanel QTableView::item:hover {
  background: rgba(@SHADOW_RGB@, 0.04);
}

TablePreviewPanel QTableView::item:selected {
  background: palette(highlight);
  color: palette(highlighted-text);
}

TablePreviewPanel QHeaderView::section {
  background: transparent;
  color: rgba(@SHADOW_RGB@, 0.65);
  font-size: 11pt;
  font-weight: 600;
  letter-spacing: 0;
  padding: 4px 8px;
  border: none;
  border-bottom: 1px solid rgba(@SHADOW_RGB@, 0.10);
  border-right: 1px solid rgba(@SHADOW_RGB@, 0.06);
}

TablePreviewPanel QHeaderView::section:last {
  border-right: none;
}

QMessageBox QLabel {
  min-width: 0px;
  max-width: 360px;
}

QPlainTextEdit#logViewerText {
  background: palette(base);
  border: 1px solid rgba(@SHADOW_RGB@, 0.10);
  border-radius: 8px;
  padding: 6px 8px;
  selection-background-color: palette(highlight);
}

HtmlResultsView#chartNotesView {
  background: palette(base);
  border: none;
  border-top: 1px solid rgba(@SHADOW_RGB@, 0.10);
}

QFrame#operationTile {
    background: rgba(@SHADOW_RGB@, 0.02);
    border: 1px solid rgba(@SHADOW_RGB@, 0.08);
    border-radius: 8px;
}

QFrame#operationTile:hover {
    background: rgba(@SHADOW_RGB@, 0.06);
    border-color: rgba(@ACCENT_RGB@, 0.35);
}

QFrame#operationTile:focus {
    background: rgba(@ACCENT_RGB@, 0.08);
    border-color: palette(highlight);
}

QLabel[operationTileTitle="true"] {
    font-size: 10.5pt;
    font-weight: 600;
    color: palette(text);
    background: transparent;
}

QLabel#operationHint {
    background: palette(base);
    border-top: 1px solid rgba(@SHADOW_RGB@, 0.08);
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding: 8px 10px;
}

/* Fills the whole scroll viewport (setWidgetResizable(True)) - styled
   because an unstyled QWidget's default background role (Window, a grey
   tone on macOS) would otherwise show through as a band between the
   operation tiles and the card's own white beneath the trailing stretch.
   See series_operation.py's own comment on #seriesOperationsContent. */
#seriesOperationsContent {
    background: palette(base);
}

/* ----------------------------------------------------------
   Flat combo box — macOS's plain/borderless popup-button idiom
   (Finder's "Ordina per:", a sidebar's own dropdown): invisible
   background and border at rest, only the text and the chevron
   read; a highlight appears on hover and while open.

   Scoped to [flat="true"], not every QComboBox: this file's own
   PLATFORM PARITY NOTES explain why QComboBox is otherwise left
   fully native - giving it any stylesheet at all switches Qt off
   native Aqua painting for the whole control, and an earlier
   attempt at a custom combo read as a double-bordered popup rather
   than a native one. Safe here only because nothing is opted in by
   default; set it explicitly (``combo.setProperty("flat", True)``)
   on the one combo that should read this way.
   ---------------------------------------------------------- */

QComboBox[flat="true"] {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 2px 26px 2px 6px;
  color: palette(text);
}

QComboBox[flat="true"]:hover {
  background: rgba(@SHADOW_RGB@, 0.06);
}

QComboBox[flat="true"]:on {
  background: rgba(@SHADOW_RGB@, 0.10);
  border-color: rgba(@SHADOW_RGB@, 0.14);
}

QComboBox[flat="true"]::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 20px;
  border: none;
  background: transparent;
}

/* No image on down-arrow: Qt draws the platform's own arrow, same
   reasoning as fluent_win11.qss's own QComboBox rule - a url() here
   would need a file on disk, and a Qt stylesheet cannot be handed one
   of this app's own themed QIcons. */

QComboBox[flat="true"] QAbstractItemView {
  background: palette(base);
  border: 1px solid rgba(@SHADOW_RGB@, 0.14);
  border-radius: 8px;
  padding: 4px;
  outline: none;
}

QComboBox[flat="true"] QAbstractItemView::item {
  padding: 5px 10px;
  border-radius: 6px;
}

QComboBox[flat="true"] QAbstractItemView::item:hover,
QComboBox[flat="true"] QAbstractItemView::item:selected {
  background: palette(highlight);
  color: palette(highlighted-text);
}